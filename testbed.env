# Every script shares this testbed definition. push.sh copies this file to
# ~/testbed.env on the gateway, and every script sources it from there. The
# gateway is the only Pi with Internet, so it runs the chain process and the
# watchtower of each arm. The two leaves reach the chain only through it.
# Change SSH_USER and the addresses to match your Pis.
SSH_USER=brady
GW_IP=10.10.0.1
PI2_IP=10.10.0.2
PI3_IP=10.10.0.3
SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=8"

# leaf_ip prints the mesh address of a leaf.
leaf_ip() {
  case $1 in
    pi2) echo "$PI2_IP" ;;
    pi3) echo "$PI3_IP" ;;
    *) echo "unknown leaf $1" >&2; return 1 ;;
  esac
}

# on_leaf runs a command on a leaf over ssh, for example on_leaf pi2 'uptime'.
on_leaf() {
  local ip
  ip=$(leaf_ip "$1") || return 1
  shift
  # shellcheck disable=SC2086
  ssh $SSH_OPTS "$SSH_USER@$ip" "$@"
}

ts() { date -u +%H:%M:%S.%3N; }

# Every experiment starts with this check, so each transcript carries the
# proof that the leaves had no Internet during the run.
offline_check() {
  local n
  for n in pi2 pi3; do
    printf '%s %s internet: ' "$(ts)" "$n"
    on_leaf "$n" 'ping -c1 -W2 1.1.1.1 >/dev/null 2>&1 && echo yes || echo no'
  done
}
