# LNMesh host inventory. Copy to hosts.env and fill in. Sourced by scripts.
# Management (Ethernet) addresses assigned by your router during bring-up.
MGMT_A=192.168.1.11
MGMT_B=192.168.1.12
MGMT_C=192.168.1.13
HOME_ROUTER=192.168.1.1
# Mesh addresses on bat0. Keep these; the scripts and docs assume them.
MESH_A=10.10.0.1
MESH_B=10.10.0.2
MESH_C=10.10.0.3
# Login users on each Pi (whatever you created in the imager or wizard).
SSH_USER_A=pi
SSH_USER_B=pi
SSH_USER_C=pi
# Filled in by scripts/build.sh phase 4 and 5. Leave blank.
BTC_RPC_PASS=
PK_A=
PK_B=
PK_C=
