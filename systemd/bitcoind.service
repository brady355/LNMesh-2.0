[Unit]
Description=Bitcoin Core for LNMesh
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bitcoin
Group=bitcoin
ExecStart=/usr/local/bin/bitcoind -conf=/etc/lnmesh/bitcoin.conf -datadir=/var/lib/bitcoin -printtoconsole
ExecStop=/usr/local/bin/bitcoin-cli -conf=/etc/lnmesh/bitcoin.conf -datadir=/var/lib/bitcoin stop
Restart=on-failure
RestartSec=10
TimeoutStopSec=600
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/bitcoin
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
