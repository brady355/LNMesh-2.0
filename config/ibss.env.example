# Deployment-specific, non-secret radio settings.  Do not use an SSID or BSSID
# shared with another installation.
IBSS_INTERFACE=wlan0
IBSS_SSID=REPLACE-WITH-DEPLOYMENT-SSID
IBSS_BSSID=02:77:00:00:00:01
IBSS_FREQUENCY_MHZ=2412
IBSS_COUNTRY=US
BATMAN_INTERFACE=bat0
# Set only after enrollment.  No address belongs on wlan0.
LN_MESH_NODE_ADDRESS=10.77.0.2/24
LN_MESH_GATEWAY_ADDRESS=10.77.0.1
